\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces ood1000 results. ``SFT'' = MacBERT fine-tuned on the listed training data; ``mix'' = probability average of v3 and the SFT model, with the fusion weight selected by stratified 5-fold cross-validation on ood1000 --- each prediction uses weights tuned on the other folds, so no reported row's label influences its own mix weight. Binary evaluation excludes neutral examples. ``---'' = metric not reported for this run. lab2000 labels are mixed-provenance: 479 human-adjudicated rows (200 ood + 279 al) plus two-pass LLM consensus labels for the rest (Section~\ref {sec:lab2000-data}).}}{15}{table.caption.24}\protected@file@percent }
\newlabel{tab:ood}{{6}{15}{ood1000 results. ``SFT'' = MacBERT fine-tuned on the listed training data; ``mix'' = probability average of v3 and the SFT model, with the fusion weight selected by stratified 5-fold cross-validation on ood1000 --- each prediction uses weights tuned on the other folds, so no reported row's label influences its own mix weight. Binary evaluation excludes neutral examples. ``---'' = metric not reported for this run. lab2000 labels are mixed-provenance: 479 human-adjudicated rows (200 ood + 279 al) plus two-pass LLM consensus labels for the rest (Section~\ref {sec:lab2000-data})}{table.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces (a) ood1000 accuracy by system; the first three groups are our local models and the last two are off-the-shelf DeepSeek LLMs (the local Qwen3-4B baseline from Table~\ref {tab:llm} is omitted for space); the dashed line marks the measured 71.5\% second-annotator agreement with the released labels. (b) Raw pairwise agreement on the same 200-row subset: two passes of the same LLM annotator model vs.\ two humans. Raw agreement rate is reported here, not Cohen's $\kappa $; higher LLM self-agreement reflects shared inductive bias (same model) and literal rubric following rather than superior annotation quality.}}{15}{figure.caption.25}\protected@file@percent }
\newlabel{fig:lab2000}{{6}{15}{(a) ood1000 accuracy by system; the first three groups are our local models and the last two are off-the-shelf DeepSeek LLMs (the local Qwen3-4B baseline from Table~\ref {tab:llm} is omitted for space); the dashed line marks the measured 71.5\% second-annotator agreement with the released labels. (b) Raw pairwise agreement on the same 200-row subset: two passes of the same LLM annotator model vs.\^^Mtwo humans. Raw agreement rate is reported here, not Cohen's $\kappa $; higher LLM self-agreement reflects shared inductive bias (same model) and literal rubric following rather than superior annotation quality}{figure.caption.25}{}}
